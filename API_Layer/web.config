<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Show detailed errors when app fails (e.g. database connection) so you can see the real error remotely. -->
  <!-- For production, set mode="On" or "RemoteOnly" and use defaultRedirect to a custom error page. -->
  <system.web>
    <customErrors mode="Off"/>
  </system.web>

  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\ClinicAPI.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Set ASPNETCORE_ENVIRONMENT=Development only when debugging on the server; use Production otherwise -->
          <!-- <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" /> -->
        </environmentVariables>
      </aspNetCore>
      <!-- Pass through the app's response so your API's error JSON is returned instead of IIS error page -->
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
</configuration>
